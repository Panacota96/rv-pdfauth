{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakvor.example/schemas/item-custody.schema.json",
  "title": "Rakvor chain-of-custody record (per item)",
  "type": "object",
  "required": [
    "schema",
    "jurisdiction",
    "run_id",
    "evidence_id",
    "item",
    "hashes",
    "examiner",
    "operations",
    "transfers",
    "examiner_identity",
    "assistants",
    "witnesses"
  ],
  "properties": {
    "schema": {
      "const": "rakvor.item-custody/1"
    },
    "jurisdiction": {
      "enum": [
        "co",
        "fr"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_id": {
      "type": "string",
      "description": "The case registry id (E0001...) when the run is linked to a case folder, else <RUN-ID>-<NNNNN>."
    },
    "item": {
      "type": "object",
      "required": [
        "index",
        "path",
        "file_name",
        "size"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "md5",
          "sha1",
          "sha256",
          "sha512",
          "sha3-256",
          "blake3"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{32,128}$"
      },
      "maxProperties": 2
    },
    "examiner": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "version",
          "start_utc",
          "end_utc",
          "audit_first_seq",
          "audit_last_seq"
        ]
      }
    },
    "transfers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "delivered_by": {
            "oneOf": [
              {
                "$ref": "#/$defs/person"
              },
              {
                "type": "null"
              }
            ]
          },
          "received_by": {
            "oneOf": [
              {
                "$ref": "#/$defs/person"
              },
              {
                "type": "null"
              }
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "intake_utc": {
      "type": [
        "string",
        "null"
      ],
      "description": "Case folder only: when the item was registered at intake."
    },
    "examiner_identity": {
      "$ref": "#/$defs/person"
    },
    "assistants": {
      "type": "array",
      "description": "Persons who assisted the examiner.",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "witnesses": {
      "type": "array",
      "description": "Persons present (e.g. at the opening or re-sealing of a seal).",
      "items": {
        "$ref": "#/$defs/person"
      }
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "description": "Identification as the official forms ask for it; null until completed (the printed form is filled in by hand).",
      "required": [
        "name",
        "position",
        "id_type",
        "id_number"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cargo (Colombia) / qualité (France)."
        },
        "id_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. CC, CE, passport, carte nationale d'identité."
        },
        "id_number": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
