{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakvor.example/schemas/item-technical.schema.json",
  "title": "Rakvor item technical review",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "run",
    "item",
    "hashes",
    "findings",
    "limitations",
    "audit"
  ],
  "properties": {
    "schema": {
      "const": "rakvor.item-technical/1"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "actor",
        "frontend",
        "algorithms",
        "langs",
        "started_utc",
        "finished_utc",
        "elapsed_ms",
        "cancelled"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor": {
          "type": "string"
        },
        "frontend": {
          "type": "string"
        },
        "algorithms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "md5",
              "sha1",
              "sha256",
              "sha512",
              "sha3-256",
              "blake3"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "langs": {
          "type": "array",
          "items": {
            "enum": [
              "en",
              "es",
              "fr"
            ]
          },
          "minItems": 1
        },
        "started_utc": {
          "type": "string",
          "format": "date-time"
        },
        "finished_utc": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "boolean"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "index",
        "path",
        "file_name",
        "size",
        "status"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "modified_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "extension": {
          "type": [
            "string",
            "null"
          ]
        },
        "detected_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "attention",
            "problem"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^E[0-9]{4,}$",
          "description": "Case folder only: evidence id from the case registry (null when the run is not linked to a case or the item is not registered)."
        }
      }
    },
    "hashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "md5",
          "sha1",
          "sha256",
          "sha512",
          "sha3-256",
          "blake3"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{32,128}$"
      },
      "maxProperties": 2
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "params",
          "text"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "text": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "en",
                "es",
                "fr"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "title",
                "shows",
                "does_not_prove"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "shows": {
                  "type": "string"
                },
                "does_not_prove": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "audit": {
      "type": "object",
      "required": [
        "first_seq",
        "last_seq"
      ],
      "properties": {
        "first_seq": {
          "type": "integer"
        },
        "last_seq": {
          "type": "integer"
        }
      }
    },
    "pdf": {
      "description": "PDF analysis (null when the item is not a PDF or its analysis did not complete).",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "revisions",
        "signatures",
        "fonts",
        "fingerprint_dbs",
        "fingerprint_matches",
        "visual"
      ],
      "properties": {
        "revision_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "encrypted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "start_offset",
              "end_offset",
              "bytes",
              "objects_added",
              "objects_changed",
              "objects_deleted",
              "pages_changed",
              "signed_by"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "start_offset": {
                "type": "integer",
                "minimum": 0
              },
              "end_offset": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "saved_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "saved_at_info": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "saved_at_xmp": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "since_previous_s": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "producer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "creator": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "objects_added": {
                "type": "integer",
                "minimum": 0
              },
              "objects_changed": {
                "type": "integer",
                "minimum": 0
              },
              "objects_deleted": {
                "type": "integer",
                "minimum": 0
              },
              "pages_changed": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "signed_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "change_kind": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "xref_kind": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "signer_subject": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "signing_time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sub_filter": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "revision": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "covers_revision": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "digest_ok": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "signature_ok": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "docmdp": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "later_revisions": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "embedded": {
                "type": "boolean"
              },
              "first_revision": {
                "type": "integer"
              },
              "object": {
                "type": "string"
              },
              "subset_prefix": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "fingerprint_dbs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "status"
            ],
            "properties": {
              "role": {
                "enum": [
                  "starter",
                  "local",
                  "extra"
                ]
              },
              "status": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "entries": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "fingerprint_matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "revision",
              "db",
              "entry_id",
              "category",
              "matched_on"
            ],
            "properties": {
              "revision": {
                "type": "integer"
              },
              "db": {
                "type": "string"
              },
              "entry_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "matched_on": {
                "type": "string"
              },
              "matched_value": {
                "type": "string"
              },
              "trait_mismatches": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "visual": {
          "type": "object",
          "required": [
            "images"
          ],
          "properties": {
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "pairs_compared": {
              "type": [
                "integer",
                "null"
              ]
            },
            "pages_changed": {
              "type": [
                "integer",
                "null"
              ]
            },
            "dpi": {
              "type": [
                "integer",
                "null"
              ]
            },
            "images": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^visual/"
              }
            }
          }
        }
      }
    },
    "extracted_files": {
      "description": "Every file the analysis wrote in the item folder, with its digests (also in the audit log).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rel_path",
          "kind",
          "bytes",
          "hashes"
        ],
        "properties": {
          "rel_path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{32,128}$"
            }
          }
        }
      }
    },
    "case": {
      "type": [
        "object",
        "null"
      ],
      "description": "Present when the run works in a shared case folder (--case-dir).",
      "required": [
        "case_id",
        "role",
        "case_dir",
        "status",
        "intake_utc"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "intake",
            "analysis"
          ]
        },
        "case_dir": {
          "type": "string"
        },
        "status": {
          "enum": [
            "registered",
            "already_registered",
            "verified",
            "mismatch",
            "not_in_registry",
            null
          ]
        },
        "intake_utc": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
